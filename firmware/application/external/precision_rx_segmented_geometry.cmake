# Single build-time authority for the fixed p16 Precision RX PPMA geometry.
# CMake configures both the loader header and the zero-byte linker guard from
# these values. The post-build verifier reads the resulting absolute ELF
# symbols, so no independent runtime or verifier copy can silently drift.

set(PRECISION_RX_SEGMENTED_GEOMETRY_VERSION 1)
set(PRECISION_RX_SEGMENTED_M4_TAG_WORD 0x31585250)

set(PRECISION_RX_SEGMENTED_MAIN_SIZE 11304)
set(PRECISION_RX_SEGMENTED_M4_SIZE 21416)
set(PRECISION_RX_SEGMENTED_AUX0_SIZE 2372)
set(PRECISION_RX_SEGMENTED_AUX1_SIZE 1440)
set(PRECISION_RX_SEGMENTED_TRAILER_SIZE 40)
set(PRECISION_RX_SEGMENTED_CHECKSUM_SIZE 4)

set(PRECISION_RX_SEGMENTED_CODE_WINDOW_SIZE 32768)
set(PRECISION_RX_SEGMENTED_M4_LOAD_ADDRESS 0x10080000)
set(PRECISION_RX_SEGMENTED_AUX0_LOAD_ADDRESS 0x100890D8)
set(PRECISION_RX_SEGMENTED_AUX0_MAX_SIZE 2384)
set(PRECISION_RX_SEGMENTED_AUX1_LOAD_ADDRESS 0x10089A60)
set(PRECISION_RX_SEGMENTED_AUX1_MAX_SIZE 1440)
set(PRECISION_RX_SEGMENTED_SHARED_MEMORY_END 0x1008A000)

set(PRECISION_RX_SEGMENTED_MAIN_FAKE_BASE 0xAE0D0000)
set(PRECISION_RX_SEGMENTED_AUX0_FAKE_BASE 0xCE0D0000)
set(PRECISION_RX_SEGMENTED_AUX1_FAKE_BASE 0xCE0D0988)

math(EXPR PRECISION_RX_SEGMENTED_M0_LOAD_ADDRESS
	"${PRECISION_RX_SEGMENTED_M4_LOAD_ADDRESS} + ${PRECISION_RX_SEGMENTED_M4_SIZE}")
math(EXPR PRECISION_RX_SEGMENTED_IMAGE_SIZE
	"${PRECISION_RX_SEGMENTED_MAIN_SIZE} + ${PRECISION_RX_SEGMENTED_M4_SIZE} + ${PRECISION_RX_SEGMENTED_AUX0_SIZE} + ${PRECISION_RX_SEGMENTED_AUX1_SIZE}")
math(EXPR PRECISION_RX_SEGMENTED_FILE_SIZE
	"${PRECISION_RX_SEGMENTED_IMAGE_SIZE} + ${PRECISION_RX_SEGMENTED_TRAILER_SIZE} + ${PRECISION_RX_SEGMENTED_CHECKSUM_SIZE}")

if(NOT PRECISION_RX_SEGMENTED_M0_LOAD_ADDRESS EQUAL 0x100853A8)
	message(FATAL_ERROR "Precision RX segmented M0 load address changed")
endif()
if(NOT PRECISION_RX_SEGMENTED_IMAGE_SIZE EQUAL 36532)
	message(FATAL_ERROR "Precision RX segmented image size changed")
endif()
if(NOT PRECISION_RX_SEGMENTED_FILE_SIZE EQUAL 36576)
	message(FATAL_ERROR "Precision RX segmented file size changed")
endif()
